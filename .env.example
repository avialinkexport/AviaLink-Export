# =========================================================
# AVIALINK Export Platform - Environment Variables Template
# Railway automatically assigns PORT, but you can set defaults here.
# =========================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Admin Security (Mandatory for Admin Panel)
# Set a strong admin password for Railway production deployment
ADMIN_PASSWORD=change_this_to_a_strong_password_123

# Optional: Supabase Database Integration (Persistent Storage)
# If left empty, the application uses local fast storage with fallback
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Gemini AI Key (AI Search Assistant)
GEMINI_API_KEY=

# Optional: Webhooks & Integrations
CRM_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=

# Company Contact Information Overrides (Optional)
COMPANY_PHONE=+201000000000
COMPANY_EMAIL=info@avialink-eg.com
COMPANY_WHATSAPP=+201000000000
COMPANY_WHATSAPP_LINK=https://wa.me/201000000000
